---
// src/layouts/MainLayout.astro
import CustomCursor from "../components/CustomCursor.astro";
import "../styles/global.css";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon" />

    <!-- Inject the dynamic title -->
    <title>{title}</title>
  </head>
  <body>
    <CustomCursor/>
    <nav>
      <div class="nav-container">
        <!-- Left Side: Logo & Links -->
        <div class="nav-group">
          <div class="nav-inner">
            <a href="/">
              <img
                src="https://img.icons8.com/?size=100&id=R5ZG0w24Cf2G&format=png&color=000000"
                alt="site-logo"
                class="nav-logo"
              />
            </a>
            <ul class="nav-menu">
              <li><a href="/">Home</a></li>
              <li><a href="/about">About Me</a></li>
              <li><a href="/works">Works</a></li>
            </ul>
          </div>
        </div>

        <!-- Right Side: Contact Button & Mobile Icon -->
        <div class="nav-actions">
          <button class="btn-contact">Contact Me</button>
          <span class="btn-arrow">→</span>
          <img
            src="https://img.icons8.com/?size=100&id=36389&format=png&color=000000"
            alt="mobile-menu"
            class="mobile-menu-btn"
          />
        </div>
      </div>
    </nav>

    <slot />

    <!-- <footer>
      <p>&copy; 2026 Creative Portfolio. All rights reserved.</p>
    </footer> -->
  </body>
</html>

<style is:global>
  body {
    font-family: "Google Sans", Arial, sans-serif;
    margin: 0;
    /* padding: 2rem; */
    background-color: #f4f4f4;
  }

  footer {
    background-color: #333;
    color: white;
    text-align: center;
    padding: 1rem;
    margin-top: 2rem;
  }
</style>
