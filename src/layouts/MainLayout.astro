---
// src/layouts/MainLayout.astro

import Contact from "../components/global/Contact.astro";
import CustomCursor from "../components/global/CustomCursor.astro";
import Footer from "../components/global/Footer.astro";
import Navbar from "../components/global/Navbar.astro";
import ScrollToTop from "../components/global/ScrollToTop.astro";
import Preloader from "../components/Preloader.astro";

import "../styles/global.css";

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon" />

    <!-- Inject the dynamic title -->
    <title>{title}</title>
  </head>
  
  <body>
    <CustomCursor />
  
    <Navbar/>

    <slot />

    <ScrollToTop />

    <Contact />
    <Footer />
  </body>
</html>
