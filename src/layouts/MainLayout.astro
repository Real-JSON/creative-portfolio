---
import { ClientRouter } from "astro:transitions";

// src/layouts/MainLayout.astro
import CustomCursor from "../components/CustomCursor.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import Contact from "../components/Contact.astro";
import Preloader from "../components/Preloader.astro";

import "../styles/global.css";
import Footer from "../components/Footer.astro";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon" />

    <!-- Inject the dynamic title -->
    <title>{title}</title>

    <ClientRouter />
  </head>
  <body>

    <Preloader/>

    <CustomCursor />
    <nav>
      <div class="nav-container">
        <!-- Left Side: Logo & Links -->
        <div class="nav-group">
          <div class="nav-inner">
            <a href="/">
              <img
                src="https://img.icons8.com/?size=100&id=R5ZG0w24Cf2G&format=png&color=000000"
                alt="site-logo"
                class="nav-logo"
              />
            </a>
            <ul class="nav-menu">
              <li><a href="/">Home</a></li>
              <li><a href="/about">About Me</a></li>
              <li><a href="/works">Works</a></li>
            </ul>
          </div>
        </div>

        <!-- Right Side: Contact Button & Mobile Icon -->
        <div class="nav-actions">
          <button class="btn-contact">Contact Me</button>
          <span class="btn-arrow">→</span>
          <img
            src="https://img.icons8.com/?size=100&id=36389&format=png&color=000000"
            alt="mobile-menu"
            class="mobile-menu-btn"
          />
        </div>
      </div>
    </nav>

    <slot />

    <ScrollToTop />

    <Contact />
    <Footer />
  </body>
</html>
