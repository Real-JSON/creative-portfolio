---
import SpotlightText from "./SpotlightText.astro";

// You can pass dynamic data as props or keep it as-is
const currentYear = new Date().getFullYear();
---

<footer
  class="w-full bg-[#161616] text-white border-t-2 border-black border-b-2"
>
  <!-- TOP SECTION -->
  <div class="grid grid-cols-1 lg:grid-cols-2 border-b-2 border-black">
    <!-- Top Left: Bio & Large K Logo -->
    <div
      class="p-6 md:p-8 border-b-2 lg:border-b-0 lg:border-r-2 border-black flex flex-col justify-between relative min-h-55"
    >
      <div class="flex justify-between items-start gap-6">
        <div class="max-w-md space-y-4">
          <p class="font-bold text-sm tracking-wide">
            Kasun Navodya &copy; {currentYear}
          </p>
          <p
            class="text-xs md:text-sm text-neutral-700 leading-relaxed uppercase"
          >
            Working with brands ready to break the mould. If you're bored of
            blending in drop us a line and let's bring your brand to life.
          </p>
        </div>
        <!-- K Graphic -->
        <div
          class="shrink-0 w-16 h-16 md:w-20 md:h-20 flex items-center justify-center"
        >
          <svg viewBox="0 0 100 100" class="w-full h-full fill-current">
            <path
              d="M10 10 H35 V42 L70 10 H100 L58 50 L100 90 H70 L35 54 V90 H10 Z"
            ></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Top Right: Navigation Links -->
    <div class="p-6 md:p-8 flex flex-col justify-between relative min-h-55">
      <div class="grid grid-cols-2 gap-8">
        <!-- Column 1 -->
        <div>
          <h4 class="text-xs font-bold text-neutral-500 mb-4 tracking-wider">
            Website:
          </h4>
          <ul class="space-y-3 text-xs md:text-sm font-semibold">
            <li>
              <a
                href="#"
                class="flex justify-between items-center pb-1 border-b border-dashed border-black/40 hover:border-black transition-colors"
              >
                <span>WORK</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  class="navigation-icon"
                >
                  <path d="M0 0h24v24H0z" fill="none"></path>
                  <path
                    fill="currentColor"
                    d="M11 20V7.75L5.75 13L5 12.34l6.5-6.5l6.5 6.5l-.75.66L12 7.75V20z"
                  ></path>
                </svg>
              </a>
            </li>
            <li>
              <a
                href="#"
                class="flex justify-between items-center pb-1 border-b border-dashed border-black/40 hover:border-black transition-colors"
              >
                <span>ABOUT</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  class="navigation-icon"
                >
                  <path d="M0 0h24v24H0z" fill="none"></path>
                  <path
                    fill="currentColor"
                    d="M11 20V7.75L5.75 13L5 12.34l6.5-6.5l6.5 6.5l-.75.66L12 7.75V20z"
                  ></path>
                </svg>
              </a>
            </li>
            <li>
              <a
                href="#"
                class="flex justify-between items-center pb-1 border-b border-dashed border-black/40 hover:border-black transition-colors"
              >
                <span>CONTACT</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  class="navigation-icon"
                >
                  <path d="M0 0h24v24H0z" fill="none"></path>
                  <path
                    fill="currentColor"
                    d="M11 20V7.75L5.75 13L5 12.34l6.5-6.5l6.5 6.5l-.75.66L12 7.75V20z"
                  ></path>
                </svg>
              </a>
            </li>
          </ul>
        </div>

        <!-- Column 2 -->
        <div>
          <h4 class="text-xs font-bold text-neutral-500 mb-4 tracking-wider">
            Interweb:
          </h4>
          <ul class="space-y-3 text-xs md:text-sm font-semibold">
            <li>
              <a
                href="#"
                class="flex justify-between items-center pb-1 border-b border-dashed border-black/40 hover:border-black transition-colors"
              >
                <span>PHOTO BOOK</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  class="navigation-icon"
                >
                  <path d="M0 0h24v24H0z" fill="none"></path>
                  <path
                    fill="currentColor"
                    d="M11 20V7.75L5.75 13L5 12.34l6.5-6.5l6.5 6.5l-.75.66L12 7.75V20z"
                  ></path>
                </svg>
              </a>
            </li>
            <li>
              <a
                href="#"
                class="flex justify-between items-center pb-1 border-b border-dashed border-black/40 hover:border-black transition-colors"
              >
                <span>FOLIOSTACK</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  class="navigation-icon"
                >
                  <path d="M0 0h24v24H0z" fill="none"></path>
                  <path
                    fill="currentColor"
                    d="M11 20V7.75L5.75 13L5 12.34l6.5-6.5l6.5 6.5l-.75.66L12 7.75V20z"
                  ></path>
                </svg>
              </a>
            </li>
            <li>
              <a
                href="#"
                class="flex justify-between items-center pb-1 border-b border-dashed border-black/40 hover:border-black transition-colors"
              >
                <span>LINKBOARD</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  class="navigation-icon"
                >
                  <path d="M0 0h24v24H0z" fill="none"></path>
                  <path
                    fill="currentColor"
                    d="M11 20V7.75L5.75 13L5 12.34l6.5-6.5l6.5 6.5l-.75.66L12 7.75V20z"
                  ></path>
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- MIDDLE SECTION: Contact Info & Social Icons Grid -->
  <div
    class="grid grid-cols-1 lg:grid-cols-12 border-b-2 border-black items-stretch"
  >
    <!-- Contact & Tagline -->
    <div
      class="lg:col-span-7 p-4 md:p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b-2 lg:border-b-0 lg:border-r-2 border-black"
    >
      <div>
        <span class="text-xs text-neutral-500 block">Contact Me:</span>
        <a
          href="mailto:kasun@design.com"
          class="text-sm font-bold hover:underline">kasun@design.com</a
        >
      </div>
      <div class="text-xs md:text-sm font-bold flex items-center gap-2">
        <span>&rarr;</span>
        <span>Brand / Product / Creative</span>
      </div>
    </div>

    <!-- Social Icons Grid -->
    <div class="lg:col-span-5 grid grid-cols-5 divide-x-2 divide-black">
      <!-- Dribbble -->
      <a
        href="#"
        aria-label="X"
        class="p-4 flex items-center justify-center hover:bg-black hover:text-white transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 48 48"
        >
          <path d="M0 0h48v48H0z" fill="none"></path>
          <defs>
            <mask id="SVGgLO3nckm">
              <g
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="4"
              >
                <path
                  fill="#fff"
                  stroke="#fff"
                  d="M44 24a19.94 19.94 0 0 1-5.889 14.173A19.94 19.94 0 0 1 24 44C12.954 44 4 35.046 4 24a19.93 19.93 0 0 1 5.5-13.775A19.94 19.94 0 0 1 24 4a19.94 19.94 0 0 1 14.111 5.827A19.94 19.94 0 0 1 44 24"
                ></path>
                <path
                  stroke="#000"
                  d="M44 24c-2.918 0-10.968-1.1-18.173 2.063C18 29.5 12.333 34.832 9.863 38.147"
                ></path>
                <path
                  stroke="#000"
                  d="M16.5 5.454C19.63 8.343 26.46 15.698 29 23s3.48 16.28 4.06 18.835"
                ></path>
                <path
                  stroke="#000"
                  d="M4.154 21.5c3.778.228 13.779.433 20.179-2.3s11.907-7.76 13.796-9.355"
                ></path>
                <path
                  stroke="#fff"
                  d="M5.5 31.613a20.08 20.08 0 0 0 9 9.991M4 24a19.93 19.93 0 0 1 5.5-13.775M24 4a19.94 19.94 0 0 0-14.5 6.225M32 5.664a20 20 0 0 1 6.111 4.163A19.94 19.94 0 0 1 44 24c0 2.462-.445 4.821-1.26 7M24 44a19.94 19.94 0 0 0 14.111-5.827"
                ></path>
              </g>
            </mask>
          </defs>
          <path fill="currentColor" d="M0 0h48v48H0z" mask="url(#SVGgLO3nckm)"
          ></path>
        </svg>
      </a>

      <!-- Pinterest -->
      <a
        href="#"
        aria-label="Pinterest"
        class="p-4 flex items-center justify-center hover:bg-black hover:text-white transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path d="M0 0h24v24H0z" fill="none"></path>
          <path
            fill="currentColor"
            d="M9.04 21.54c.96.29 1.93.46 2.96.46a10 10 0 0 0 10-10A10 10 0 0 0 12 2A10 10 0 0 0 2 12c0 4.25 2.67 7.9 6.44 9.34c-.09-.78-.18-2.07 0-2.96l1.15-4.94s-.29-.58-.29-1.5c0-1.38.86-2.41 1.84-2.41c.86 0 1.26.63 1.26 1.44c0 .86-.57 2.09-.86 3.27c-.17.98.52 1.84 1.52 1.84c1.78 0 3.16-1.9 3.16-4.58c0-2.4-1.72-4.04-4.19-4.04c-2.82 0-4.48 2.1-4.48 4.31c0 .86.28 1.73.74 2.3c.09.06.09.14.06.29l-.29 1.09c0 .17-.11.23-.28.11c-1.28-.56-2.02-2.38-2.02-3.85c0-3.16 2.24-6.03 6.56-6.03c3.44 0 6.12 2.47 6.12 5.75c0 3.44-2.13 6.2-5.18 6.2c-.97 0-1.92-.52-2.26-1.13l-.67 2.37c-.23.86-.86 2.01-1.29 2.7z"
          ></path>
        </svg>
      </a>

      <!-- Instagram -->
      <a
        href="#"
        aria-label="Instagram"
        class="p-4 flex items-center justify-center hover:bg-black hover:text-white transition-colors"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
          ></path>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href="#"
        aria-label="LinkedIn"
        class="p-4 flex items-center justify-center hover:bg-black hover:text-white transition-colors"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path
            d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
          ></path>
        </svg>
      </a>

      <!-- Behance -->
      <a
        href="#"
        aria-label="Featured"
        class="p-4 flex items-center justify-center hover:bg-black hover:text-white transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path d="M0 0h24v24H0z" fill="none"></path>
          <path
            fill="currentColor"
            d="M7.443 5.35c.639 0 1.23.05 1.77.198c.541.099.984.297 1.377.544q.591.371.885 1.039c.197.445.296.99.296 1.583c0 .693-.148 1.286-.492 1.731c-.295.446-.787.841-1.377 1.138c.836.248 1.475.693 1.869 1.286s.639 1.336.639 2.177c0 .693-.148 1.286-.394 1.781c-.245.495-.639.94-1.082 1.237a5.1 5.1 0 0 1-1.573.692c-.59.149-1.18.248-1.77.248H1V5.35zm-.394 5.54c.541 0 .984-.148 1.328-.395s.492-.693.492-1.237c0-.297-.05-.594-.148-.791s-.246-.347-.442-.495a2.4 2.4 0 0 0-.64-.247c-.246-.05-.491-.05-.787-.05H4v3.216zm.148 5.838c.295 0 .59-.05.836-.099c.246-.05.492-.148.688-.297a1.8 1.8 0 0 0 .492-.544c.098-.247.197-.544.197-.89c0-.693-.197-1.188-.59-1.534c-.394-.297-.935-.445-1.574-.445H4v3.81zm9.492-.05q.59.594 1.77.594c.541 0 1.033-.148 1.426-.395q.591-.446.738-.891h2.41c-.394 1.187-.984 2.028-1.77 2.572c-.788.495-1.722.792-2.853.792a5.8 5.8 0 0 1-2.115-.396a3.9 3.9 0 0 1-1.574-1.088a3.9 3.9 0 0 1-.983-1.633c-.246-.643-.345-1.335-.345-2.127c0-.742.099-1.434.345-2.078a5.3 5.3 0 0 1 1.033-1.682c.442-.445.983-.84 1.573-1.088a5.5 5.5 0 0 1 2.066-.396c.836 0 1.574.149 2.213.495c.64.346 1.131.742 1.524 1.336c.394.544.69 1.187.886 1.88c.098.692.147 1.385.098 2.176H16c0 .792.295 1.534.689 1.93m3.098-5.194c-.344-.346-.885-.544-1.525-.544a2.34 2.34 0 0 0-1.082.247c-.295.149-.491.347-.688.545a1.3 1.3 0 0 0-.344.692c-.05.248-.099.445-.099.643h4.426c-.098-.742-.344-1.236-.688-1.583M15.459 6.29h5.508v1.336H15.46z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
  <!-- BOTTOM UTILITY FOOTER -->
  <div
    class="px-6 md:px-22 py-4 flex flex-col sm:flex-row justify-between items-center text-xs font-bold gap-2"
  >
    <div class="w-5 h-5">
      <svg viewBox="0 0 100 100" class="w-full h-full fill-current">
        <path d="M10 10 H35 V42 L70 10 H100 L58 50 L100 90 H70 L35 54 V90 H10 Z"
        ></path>
      </svg>
    </div>
    <p class="text-neutral-500">
      Design & Developed by <span class="text-amber-50">JSON</span>
    </p>
  </div>
</footer>
