---
// src/components/CustomCursor.astro
---

<div class="custom-cursor"></div>

<style>
  /* 1. Hide default cursor globally */
  /* :global(*) {
    cursor: none !important;
  } */

  /* 2. Normal Dot Cursor */
  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    background-color: #ffffff;
    border-radius: 50%;
    pointer-events: none;
    z-index: 99999;
    transform: translate(-50%, -50%);
    transition:
      width 0.3s ease,
      height 0.3s ease,
      background-color 0.3s ease;
  }

  /* 3. Hovering Expanded State */
  .custom-cursor.hovered {
    width: 70px;
    height: 70px;
    background-color: rgba(255, 255, 255, 0.15);
  }

  /* 4. Disable on touch devices */
  @media (pointer: coarse) {
    .custom-cursor {
      display: none;
    }
  }
</style>

<script>
  const setupCursor = () => {
    const cursor = document.querySelector('.custom-cursor') as HTMLElement;
    if (!cursor) return;

    // Move cursor with mouse
    window.addEventListener('mousemove', (e) => {
      cursor.style.left = `${e.clientX}px`;
      cursor.style.top = `${e.clientY}px`;
    });

    // Detect hover on interactive elements
    document.addEventListener('mouseover', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('a, button, input, textarea, .navigation-icon')) {
        cursor.classList.add('hovered');
      }
    });

    // Remove hover on uninteractive elements
    document.addEventListener('mouseout', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('a, button, input, textarea, .navigation-icon')) {
        cursor.classList.remove('hovered');
      }
    });
  }

  // Run on initial page load
  setupCursor();

  // Re-run if you are using Astro View Transitions
  document.addEventListener('astro:after-swap', setupCursor);
</script>