---
// Define the experience items data
const experiences = [
  {
    period: "2024 – PRESENT",
    role: "Freelance Visual Creative",
    description:
      "Working with global clients on photography, design and creative direction.",
  },
  {
    period: "2022 – 2024",
    role: "Senior Designer",
    description:
      "Designing brand identities, digital experiences and visual content for agencies.",
  },
  {
    period: "2020 – 2022",
    role: "Creative Designer",
    description:
      "Focused on branding, illustration and visual storytelling.",
  },
  {
    period: "2019 – 2020",
    role: "Design Intern",
    description:
      "Started my creative journey and learned the foundation of design.",
  },
];
---

<section class="text-neutral-900 py-16 md:py-24 px-6 md:px-12 lg:px-20">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    
    {/* Left Column: Heading & Feature Image */}
    <div class="lg:col-span-6 flex flex-col">
      <!-- Section Label -->
      <span class="text-xs font-mono tracking-widest text-neutral-500 uppercase mb-4">
        / Experience
      </span>

      <!-- Main Headline -->
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight leading-[0.95] text-white mb-10">
        A journey of<br />creativity &amp; growth.
      </h2>

      <!-- Architectural Monochromatic Image -->
      <div class="w-full aspect-4/3 overflow-hidden bg-neutral-200">
        <img
          src="https://images.unsplash.com/photo-1513694203232-719a280e022f?q=80&w=1200&auto=format&fit=crop"
          alt="Architectural space with silhouette"
          class="w-full h-full object-cover grayscale contrast-125"
          loading="lazy"
        />
      </div>
    </div>

    {/* Right Column: Vertical Timeline List */}
    <div class="lg:col-span-6 lg:pt-8">
      <div class="relative pl-8 md:pl-10 space-y-12">
        
        <!-- Timeline Line -->
        <div class="absolute left-1.25 top-2 -bottom-10 w-px bg-neutral-300"></div>

        {experiences.map((item) => (
          <div class="relative group">
            {/* Timeline Indicator Dot */}
            <div class="absolute -left-8 md:-left-10 top-1.5 h-3 w-3 rounded-full border-2 border-neutral-400 bg-[#fcfbf9] group-hover:bg-neutral-900 transition-colors duration-300"></div>

            {/* Date / Period */}
            <span class="block text-xs font-mono tracking-wider text-neutral-500 uppercase mb-1">
              {item.period}
            </span>

            {/* Job Title */}
            <h3 class="text-lg md:text-xl font-bold text-white mb-2">
              {item.role}
            </h3>

            {/* Description */}
            <p class="text-sm md:text-base text-neutral-600 font-normal leading-relaxed max-w-md">
              {item.description}
            </p>
          </div>
        ))}

      </div>
    </div>

  </div>
</section>