---
// Define the experience items data
const experiences = [
  {
    period: "2024 – PRESENT",
    role: "Freelance Visual Creative",
    description:
      "Working with global clients on photography, design and creative direction.",
  },
  {
    period: "2022 – 2024",
    role: "Senior Designer",
    description:
      "Designing brand identities, digital experiences and visual content for agencies.",
  },
  {
    period: "2020 – 2022",
    role: "Creative Designer",
    description: "Focused on branding, illustration and visual storytelling.",
  },
  {
    period: "2019 – 2020",
    role: "Design Intern",
    description:
      "Started my creative journey and learned the foundation of design.",
  },
];
---

<section class="text-neutral-900 py-16 md:py-24 px-6 md:px-12 lg:px-20">
  <div
    class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start"
  >
    {/* Left Column: Heading */}
    <div class="lg:col-span-6 flex flex-col">
      <!-- Section Label -->
      <div class="flex items-center gap-5">
        <div class="circle bg-white rounded-full w-2 h-2"></div>
        <span class="text-xs md:text-sm tracking-widest text-neutral-500 uppercase"
          >Experience</span
        >
      </div>

      <!-- Main Headline -->
      <h2
        class="text-4xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight leading-[0.95] text-white my-10"
      >
        A journey of<br />creativity &amp; growth.
      </h2>
    </div>

    {/* Right Column: Vertical Timeline List */}
    <div class="lg:col-span-6 lg:pt-8">
      <div class="relative pl-8 md:pl-10 space-y-12">
        <!-- Timeline Line -->
        <div class="absolute left-1.25 top-2 -bottom-10 w-px bg-neutral-300">
        </div>

        {
          experiences.map((item) => (
            <div class="relative group">
              {/* Timeline Indicator Dot */}
              <div class="absolute -left-8 md:-left-10 top-1.5 h-3 w-3 rounded-full border border-white bg-[#fcfbf9] group-hover:bg-neutral-900 transition-colors duration-300" />

              {/* Date / Period */}
              <span class="block text-xs tracking-wider text-neutral-500 uppercase mb-1">
                {item.period}
              </span>

              {/* Job Title */}
              <h3 class="text-lg md:text-xl font-bold text-white mb-2">
                {item.role}
              </h3>

              {/* Description */}
              <p class="text-sm md:text-base text-neutral-600 font-normal leading-relaxed max-w-md">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
