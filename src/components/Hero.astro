---
import { Image } from "astro:assets";
import heroImage from "../assets/hero-image.png";
import Marquee from "./Marquee.astro";
---

<section
  class="relative bg-[#1a1a1a] text-white h-auto md:h-screen w-full overflow-hidden flex flex-col justify-between -mt-25 pt-28"
>
  <!-- Background Pattern -->
  <div
    class="absolute inset-0 bg-[url(/src/assets/dots.png)] bg-repeat md:opacity-10 z-0 w-[40%] mx-auto pointer-events-none"
  >
  </div>

  <!-- Central Container (Constrained strictly inside viewport height on MD+) -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-12 flex-1 flex flex-col justify-between items-center h-full">
    
    <!-- Header / Title Section -->
    <div class="text-center pt-2 md:pt-4">
      <h1 class="text-lg md:text-xl tracking-wider text-gray-300">Hello, I'm</h1>
      <span class="text-[clamp(2rem,4.5vw,3.5rem)] font-bold block my-0.5 leading-tight">
        Kasun Navodya
      </span>
      <p class="text-gray-300 text-xs md:text-sm lg:text-base mt-3">
        Creative Designer Based in Sri Lanka
      </p>
    </div>

    <!-- Main Grid Content -->
    <div class="w-full grid grid-cols-1 md:grid-cols-3 items-end gap-4 md:gap-6 flex-1">
      
      <!-- Left Content (Desktop Only) -->
      <div class="hidden md:flex flex-col gap-12 lg:gap-20 pb-4 lg:pb-8 z-20 text-left">
        <div>
          <h3 class="text-xl lg:text-2xl font-semibold mb-1">Expertise</h3>
          <p class="text-gray-300 text-xs lg:text-sm">
            Graphic Designing & Videography
          </p>
        </div>

        <div class="mb-6">
          <div class="flex gap-2 items-center">
            <span class="text-xl text-white">★★★★★</span>
            <h3 class="text-xl lg:text-2xl font-bold">4.8</h3>
          </div>
          <p class="text-gray-300 text-sm lg:text-base">300+ Client Reviews</p>
        </div>
      </div>

      <!-- Center Image (Fills max available viewport height on MD+) -->
      <div class="relative flex justify-center items-end w-full overflow-hidden z-10 h-full">
        <Image
          src={heroImage}
          alt="Kasun Navodya"
          class="w-auto grayscale object-cover object-top max-h-80 sm:max-h-95 md:h-[52vh] md:scale-150 md:max-h-130 lg:h-[58vh] lg:max-h-155 xl:max-h-170"
        />
      </div>

      <!-- Right Content (Desktop Only) -->
      <div class="hidden md:flex flex-col gap-12 lg:gap-20 pb-4 lg:pb-8 z-20 text-right">
        <div class="flex items-end gap-3 justify-end">
          <h3 class="text-right text-base lg:text-lg leading-tight mb-1">
            Years <br /> Of Experience
          </h3>
          <span class="text-5xl lg:text-6xl font-bold">5</span>
        </div>
        <div>
          <h3 class="text-xl lg:text-2xl font-semibold mb-1">Featured Work</h3>
          <p class="text-gray-300 text-xs lg:text-sm">
            Logo Design for Barista
          </p>
          <a
            href="/works"
            class="underline text-xs lg:text-sm mt-1 inline-block hover:text-gray-300"
          >
            Explore
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
<Marquee/>
