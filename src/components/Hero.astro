---
import Marquee from "./Marquee.astro";
---

<section
  class="relative bg-[#1a1a1a] text-white min-h-screen w-full overflow-hidden flex flex-col justify-between -mt-25"
>
  <!-- Background Pattern -->
  <div
    class="absolute inset-0 bg-[url(/src/assets/dots.png)] bg-repeat opacity-10 z-0 w-[40%] mx-auto pointer-events-none"
  >
  </div>

  <!-- Header / Title Section -->
  <div class="relative z-10 pt-30 pb-6 text-center">
    <h1 class="text-xl md:text-2xl tracking-wider text-gray-300">Hello, I'm</h1>
    <span class="text-[clamp(2rem,5vw,4rem)] font-bold block"
      >Kasun Navodya</span
    >
    <p class="text-gray-300 text-sm md:text-base">
      Creative Designer Based in Sri Lanka
    </p>
  </div>

  <!-- Main Grid Content -->
  <div
    class="relative z-10 container mx-auto px-6 md:px-12 flex-1 flex items-end"
  >
    <div class="w-full grid grid-cols-1 md:grid-cols-3 items-center gap-6 pb-0">
      <!-- Left Content (Desktop Only) -->
      <div class="hidden md:flex flex-col gap-20 pb-12 z-20 text-left">
        <div>
          <h3 class="text-2xl lg:text-3xl font-semibold mb-1">Expertise</h3>
          <p class="text-gray-300 text-sm lg:text-base">
            Graphic Designing & Videography
          </p>
        </div>

        <div>
          <div class="flex gap-2 items-center mb-1">
            <span class="text-2xl text-white">★★★★★</span>
            <h3 class="text-2xl lg:text-3xl font-bold">4.8</h3>
          </div>
          <p class="text-gray-300 text-sm">300+ Client Reviews</p>
        </div>
      </div>

      <!-- Center Image -->
      <div
        class="relative flex justify-center items-end w-full overflow-hidden z-10"
      >
        <img
          src="src/assets/hero-image.png"
          alt="Kasun Navodya"
          class="w-auto grayscale object-cover object-top max-h-95 sm:max-h-112.5 md:max-h-120 md:scale-150 lg:max-h-137.5 lg:scale-135"
        />
      </div>

      <!-- Right Content (Desktop Only) -->
      <div class="hidden md:flex flex-col gap-20 pb-12 z-20 text-right">
        <div class="flex items-end gap-3 justify-end">
          <h3 class="text-right text-lg lg:text-xl leading-tight">
            Years <br /> Of Experience
          </h3>
          <span class="text-6xl lg:text-7xl font-bold">5</span>
        </div>
        <div>
          <h3 class="text-2xl lg:text-3xl font-semibold mb-1">Featured Work</h3>
          <p class="text-gray-300 text-sm lg:text-base">
            Logo Design for Barista
          </p>
          <a
            href="/works"
            class="underline text-sm mt-1 inline-block hover:text-gray-300"
            >Explore</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
<Marquee/>
