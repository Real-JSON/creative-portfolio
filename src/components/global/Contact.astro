---
// You can pass dynamic form handlers or props here if needed
---

<section class="relative bg-site-bg text-white py-16 px-6 md:px-12 lg:px-20 overflow-hidden">
  <!-- Background Glow Effect -->
  <div class="absolute top-1/2 right-0 -translate-y-1/2 w-150 h-150 bg-neutral-800/20 rounded-full blur-3xl pointer-events-none -mr-40"></div>

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start relative z-10">
    
    <!-- Left Column: Content & Info -->
    <div class="lg:col-span-5 space-y-8">
      <!-- Badge -->
      <div>
        <span class="inline-block border border-neutral-700 text-xs font-semibold uppercase tracking-widest px-5 py-2 rounded-full text-neutral-300">
          Get in Touch
        </span>
      </div>

      <!-- Heading & Paragraph -->
      <div class="space-y-4">
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.1]">
          Let's make your brand brilliant!
        </h2>
        <p class="text-neutral-400 text-base leading-relaxed max-w-md">
          If you would like to work with me or just want to get in touch, I'd love to hear from you!
        </p>
      </div>

      <!-- Phone Number -->
      <div>
        <a 
          href="tel:+94760038308" 
          class="text-2xl sm:text-3xl font-bold text-white underline underline-offset-8 decoration-neutral-200 transition-colors duration-300"
        >
          +94 76 003 8308
        </a>
      </div>
    </div>

    <!-- Right Column: Contact Form -->
    <div class="lg:col-span-7">
      <form class="space-y-4" onsubmit="event.preventDefault();">
        <!-- Name & Email Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <input 
              type="text" 
              name="name"
              placeholder="Name" 
              required
              class="w-full bg-[#1c1c1c] border border-neutral-800 rounded-xl px-4 py-3.5 text-sm text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-500 transition-colors"
            />
          </div>
          <div>
            <input 
              type="email" 
              name="email"
              placeholder="Email" 
              required
              class="w-full bg-[#1c1c1c] border border-neutral-800 rounded-xl px-4 py-3.5 text-sm text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-500 transition-colors"
            />
          </div>
        </div>

        <!-- Subject -->
        <div>
          <input 
            type="text" 
            name="subject"
            placeholder="Subject" 
            required
            class="w-full bg-[#1c1c1c] border border-neutral-800 rounded-xl px-4 py-3.5 text-sm text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-500 transition-colors"
          />
        </div>

        <!-- Message -->
        <div>
          <textarea 
            name="message"
            rows="6" 
            placeholder="Message" 
            required
            class="w-full bg-[#1c1c1c] border border-neutral-800 rounded-xl px-4 py-3.5 text-sm text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-500 transition-colors resize-none"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <div>
          <button 
            type="submit" 
            class="w-full border border-neutral-700 bg-transparent hover:bg-white hover:text-black text-white font-medium py-3.5 rounded-full transition-all duration-300 text-sm tracking-wide"
          >
            Let's Talk
          </button>
        </div>
      </form>
    </div>

  </div>
</section>