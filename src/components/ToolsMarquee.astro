---
const tools = [
  { name: "Photoshop", icon: "https://files.svgcdn.io/devicon/photoshop.svg" },
  { name: "Blender", icon: "https://files.svgcdn.io/devicon/blender.svg" },
  { name: "Illustrator", icon: "https://files.svgcdn.io/logos/adobe-illustrator.svg" },
  { name: "Premiere Pro", icon: "https://files.svgcdn.io/logos/adobe-premiere.svg" },
  { name: "After Effects", icon: "https://files.svgcdn.io/logos/adobe-after-effects.svg" },
  { name: "Lightroom", icon: "https://files.svgcdn.io/logos/adobe-lightroom.svg" },
];

const doubleTools = [...tools, ...tools, ...tools, ...tools];
---

<section class="bg-[#161616] text-white py-20 overflow-hidden relative">
  <!-- Header -->
  <div class="max-w-7xl mx-auto px-4 text-center mb-16">
    <div class="inline-block mb-3">
      <span class="text-[10px] sm:text-xs font-semibold tracking-wider text-zinc-300 uppercase px-4 py-1.5 rounded-full border border-zinc-700/60 bg-zinc-800/40">
        OUR TOOLS
      </span>
    </div>
    <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
      Tools I've Worked With
    </h2>
  </div>

  <!-- Marquee Area with Extra Padding at Bottom -->
  <div class="relative w-full overflow-hidden pt-4 pb-16 sm:pb-24">
    <div class="marquee-track flex animate-scroll hover:[animation-play-state:paused]">
      {doubleTools.map((tool, index) => (
        <div class={`flex-shrink-0 mx-2 sm:mx-3 ${index % 2 === 1 ? 'translate-y-12 sm:translate-y-20' : ''}`}>
          <div class="w-36 h-36 sm:w-64 sm:h-64 rounded-full bg-[#1e1e1e] border border-zinc-800/80 flex flex-col items-center justify-center p-6 shadow-2xl transition-all duration-300 hover:scale-105 hover:border-zinc-500 group cursor-pointer">
            <img 
              src={tool.icon} 
              alt={tool.name} 
              class="w-10 h-10 sm:w-20 sm:h-20 object-contain filter grayscale group-hover:grayscale-0 transition-all duration-300 opacity-70 group-hover:opacity-100"
              loading="lazy"
            />
            <span class="mt-2 text-[11px] sm:text-xs font-medium text-zinc-400 group-hover:text-white transition-colors duration-300">
              {tool.name}
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Gradient Edge Fades -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-20 sm:w-48 bg-gradient-to-r from-[#161616] via-[#161616]/80 to-transparent z-10"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-20 sm:w-48 bg-gradient-to-l from-[#161616] via-[#161616]/80 to-transparent z-10"></div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }
</style>